    {"name": "fieldos.communication.ivr", "vhost": "/fieldos", "durable": true, "auto_delete": false, "arguments": {"x-dead-letter-exchange": "fieldos.communication.dlx", "x-dead-letter-routing-key": "communication.ivr.dead"}},
