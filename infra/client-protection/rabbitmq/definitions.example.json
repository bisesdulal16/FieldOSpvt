    {"name": "fieldos.communication.sms.dead", "vhost": "/fieldos", "durable": true, "auto_delete": false, "arguments": {}},
    {"name": "fieldos.communication.ivr.dead", "vhost": "/fieldos", "durable": true, "auto_delete": false, "arguments": {}},
    {"name": "fieldos.communication.escalation.dead", "vhost": "/fieldos", "durable": true, "auto_delete": false, "arguments": {}},
    {"name": "fieldos.communication.reminder.dead", "vhost": "/fieldos", "durable": true, "auto_delete": false, "arguments": {}}
  ],
