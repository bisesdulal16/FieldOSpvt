    {"source": "fieldos.communication", "vhost": "/fieldos", "destination": "fieldos.communication.ivr", "destination_type": "queue", "routing_key": "communication.ivr", "arguments": {}},
    {"source": "fieldos.communication", "vhost": "/fieldos", "destination": "fieldos.communication.escalation", "destination_type": "queue", "routing_key": "communication.escalation", "arguments": {}},
    {"source": "fieldos.communication", "vhost": "/fieldos", "destination": "fieldos.communication.reminder", "destination_type": "queue", "routing_key": "communication.reminder", "arguments": {}},
    {"source": "fieldos.communication.dlx", "vhost": "/fieldos", "destination": "fieldos.communication.sms.dead", "destination_type": "queue", "routing_key": "communication.sms.dead", "arguments": {}},
    {"source": "fieldos.communication.dlx", "vhost": "/fieldos", "destination": "fieldos.communication.ivr.dead", "destination_type": "queue", "routing_key": "communication.ivr.dead", "arguments": {}},
    {"source": "fieldos.communication.dlx", "vhost": "/fieldos", "destination": "fieldos.communication.escalation.dead", "destination_type": "queue", "routing_key": "communication.escalation.dead", "arguments": {}},
    {"source": "fieldos.communication.dlx", "vhost": "/fieldos", "destination": "fieldos.communication.reminder.dead", "destination_type": "queue", "routing_key": "communication.reminder.dead", "arguments": {}}
