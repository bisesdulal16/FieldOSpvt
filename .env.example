# FieldOS Nepal — container stack config. Copy to .env and fill in real values.
# DO NOT commit .env (it's gitignored).

# ── Database ───────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_strong_db_password

# ── Backend security ───────────────────────────────────────────────
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_generate_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
APP_ENV=production
# Comma-separated allowed origins for the mobile app / dashboard. '*' is fine for a
# closed pilot; lock it to your dashboard URL for production.
CORS_ORIGINS=*

# ── White-label branding (rebrands the same build per institution) ─
ORG_NAME=FieldOS
ORG_TAGLINE=Nepal
ORG_PRODUCT_SUFFIX=Branch Manager Dashboard
ORG_PRIMARY_COLOR=#0B1B3A
ORG_ACCENT_COLOR=#F59E0B
ORG_LOGO_URL=

# ── Dashboard ──────────────────────────────────────────────────────
NEXT_PUBLIC_PILOT_MODE=true

# ── Production TLS (docker-compose.prod.yml: nginx + Let's Encrypt) ─
# Two public hostnames whose DNS A-records point at this server.
#   API_DOMAIN  -> mobile app + dashboard proxy target (backend)
#   DASH_DOMAIN -> manager dashboard
API_DOMAIN=api.yourorg.com.np
DASH_DOMAIN=dash.yourorg.com.np
# Email Let's Encrypt uses for expiry warnings.
LETSENCRYPT_EMAIL=ops@yourorg.com.np
# With TLS in front, lock CORS to the dashboard origin (override the '*' above):
#   CORS_ORIGINS=https://dash.yourorg.com.np

# ── Client Protection / communication ledger ──────────────────────
# Dispatch is disabled by default. Collection verification ledger rows are
# created transactionally; SMS/call workers are enabled later after provider setup.
CLIENT_PROTECTION_ENABLED=false
VERIFICATION_SMS_ENABLED=true
VERIFICATION_IVR_ENABLED=false
VERIFICATION_AI_CALL_ENABLED=false
VERIFICATION_RANDOM_SAMPLE_PERCENT=0
VERIFICATION_HIGH_VALUE_THRESHOLD=0
VERIFICATION_MAX_SMS_ATTEMPTS=3
VERIFICATION_MAX_CALL_ATTEMPTS=3
VERIFICATION_ESCALATION_HOURS=24
VERIFICATION_DEFAULT_LANGUAGE=en
VERIFICATION_DEFAULT_PRIORITY=normal
CALL_PROVIDER=log

# ── Communication outbox worker (Phase 2, safe-off by default) ─────
COMMUNICATION_WORKER_ENABLED=false
COMMUNICATION_DISPATCH_MODE=postgres
OUTBOX_POLL_INTERVAL_SECONDS=2
OUTBOX_BATCH_SIZE=50
OUTBOX_LOCK_TIMEOUT_SECONDS=300
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BASE_RETRY_SECONDS=30
OUTBOX_MAX_RETRY_SECONDS=3600
OUTBOX_LOG_PROVIDER_FAIL_PERCENT=0

# ── RabbitMQ + Redis messaging infra (Phase 8, safe-off by default) ─
RABBITMQ_ENABLED=false
RABBITMQ_URL=
RABBITMQ_VHOST=/fieldos
RABBITMQ_EXCHANGE=fieldos.communication
RABBITMQ_PREFETCH=20
RABBITMQ_PUBLISH_CONFIRM_TIMEOUT_SECONDS=10
RABBITMQ_RECONNECT_SECONDS=5
RABBITMQ_MAX_RETRIES=5
REDIS_ENABLED=false
REDIS_URL=
REDIS_KEY_PREFIX=fieldos
REDIS_MAXMEMORY=256mb

# ── SMS anti-fraud receipts ────────────────────────────────────────
# 'log' = no gateway (dev/demo); 'sparrow_http' = Sparrow HTTP;
# 'jasmin_http' = Jasmin HTTP API/SMPP bridge.
SMS_PROVIDER=log
SMS_API_TOKEN=
SMS_SENDER=
SMS_SPARROW_URL=https://api.sparrowsms.com/v2/sms/
SMS_REQUEST_TIMEOUT_SECONDS=10
# Delivery callbacks (Phase 4). Set only when exposing authenticated provider callbacks.
SMS_CALLBACK_SECRET=
SMS_CALLBACK_TIMESTAMP_TOLERANCE_SECONDS=300
# Reserved for later Jasmin/SMPP deployment phases.
JASMIN_HTTP_URL=http://jasmin:1401/send

# ── Scheduled client reminders (Phase 5, safe-off by default) ───────
REMINDERS_ENABLED=false
REMINDER_DUE_DAYS_BEFORE=1
REMINDER_OVERDUE_DAYS=1,3,7
REMINDER_QUIET_HOURS_START=20:00
REMINDER_QUIET_HOURS_END=08:00
REMINDER_MAX_PER_CLIENT_PER_DAY=1
REMINDER_MAX_PER_CLIENT_PER_WEEK=3
REMINDER_DEFAULT_LANGUAGE=ne
REMINDER_TIMEZONE=Asia/Kathmandu
REMINDER_LOOKAHEAD_DAYS=7

# ── n8n orchestration (Phase 7; safe-off, no live deployment by default) ─
N8N_INTEGRATION_ENABLED=false
N8N_WEBHOOK_URL=
N8N_SHARED_SECRET=
N8N_REQUEST_TIMEOUT_SECONDS=10
N8N_DAILY_REPORT_HOUR=8
N8N_TIMEZONE=Asia/Kathmandu
N8N_RANDOM_SAMPLE_PERCENT=0
N8N_PROVIDER_FAILURE_THRESHOLD=10
N8N_BACKLOG_AGE_THRESHOLD_SECONDS=900
N8N_REPLAY_STORE=memory
N8N_REPLAY_TTL_SECONDS=300

# ── On-prem AI (only used when you run `docker compose --profile ai up`) ──
# When the AI profile is down, voice transcription returns empty (officer types)
# and AI cleanup/summary falls back to heuristics — nothing hard-fails.
WHISPER_URL=http://whisper:8000/v1/audio/transcriptions
WHISPER_MODEL=Systran/faster-whisper-small
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=gemma2:2b

# ── Error monitoring (optional) ────────────────────────────────────
SENTRY_DSN=

# ── Mobile app ─────────────────────────────────────────────────────
# The Expo app does NOT read this file. Set EXPO_PUBLIC_API_URL in
# fieldos-app/eas.json to the VM's reachable URL, e.g.:
#   http://<vm-lan-ip>:8000/api/v1   (or your Tailscale/Cloudflare hostname)
